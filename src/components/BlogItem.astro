---
interface Props {
  post: {
    slug: string;
    body?: string;
    data: {
      title: string;
      pubDate: Date;
      description: string;
      image?: { url: string; alt: string };
      tags?: string[];
    };
  };
}

const { post } = Astro.props;

const words = post.body?.trim().split(/\s+/).length ?? 0;
const readingTime = Math.max(1, Math.round(words / 200));
---

<a
  href={`/blog/${post.slug}`}
  data-cta-host
  class="group bg-zinc-950 border-2 border-zinc-700 hover:border-zinc-300 p-6 sm:p-8 flex flex-col md:flex-row gap-6"
>
  {post.data.image && (
    <img
      src={post.data.image.url}
      alt={post.data.image.alt}
      class="w-full md:w-48 h-32 object-cover"
    />
  )}
  <div class="flex flex-col justify-between flex-1">
    <div>
      <p class="text-sm text-zinc-500 mb-2">
        {
          post.data.pubDate.toLocaleDateString("en-US", {
            year: "numeric",
            month: "long",
            day: "numeric",
          })
        }
        {" · "}
        {readingTime} min read
      </p>
      <h2 class="text-2xl sm:text-3xl font-bold text-zinc-100 mb-3">
        {post.data.title}
      </h2>
      <p class="text-zinc-400 leading-relaxed">{post.data.description}</p>
    </div>
    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      {post.data.tags && (
        <div class="flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <span class="text-xs border border-zinc-700 text-zinc-400 px-2 py-1 group-hover:border-zinc-500">
              {tag}
            </span>
          ))}
        </div>
      )}
      <span class="term-cta ml-auto text-sm font-semibold text-zinc-500">
        read more <span class="blink-on-hover">→</span>
      </span>
    </div>
  </div>
</a>
