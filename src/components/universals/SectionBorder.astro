---
const { sectionName } = Astro.props;
---

<div class="h-full group relative border-2 border-zinc-700 hover:border-zinc-400">
  <span
    class="absolute -top-4 left-6 px-2 bg-neutral-950 text-zinc-500 text-md font-semibold group-hover:text-zinc-300"
  >
    {sectionName}
  </span>
  <slot />
</div>
