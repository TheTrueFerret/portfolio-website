---
// Blurred brand-colour rectangles behind a company card's logo, in the style
// of Ferret Media's site: two staggered pairs, one in the top-left corner and
// one in the bottom-right, each block 16:9, 9:16 or square. The layout comes
// from `seed`, so a card looks the same on every visit.
//
// The parent needs `relative isolate overflow-hidden`.

interface Props {
  seed: string;
  /** The two brand colours; a pair always has one of each. */
  colors: [string, string];
}

const { seed, colors } = Astro.props;

const FORMATS = [16 / 9, 9 / 16, 1];

/** mulberry32, seeded from the string with FNV-1a. */
function random(text: string) {
  let a = 2166136261;
  for (let i = 0; i < text.length; i++) a = Math.imul(a ^ text.charCodeAt(i), 16777619);
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const rng = random(seed);
const between = (min: number, max: number) => min + rng() * (max - min);

/** Sizes that give the three formats about the same weight in a 176px
 * banner, small enough that a corner pair stays clear of the logo. */
function sized(format: number) {
  const ratio = FORMATS[format];
  if (ratio > 1) return { w: between(100, 120), ratio };
  if (ratio < 1) return { w: between(120, 140) * ratio, ratio };
  return { w: between(72, 88), ratio };
}

/* Each corner gets a pair of two different formats, the second stepped
 * mostly along the edge (the banner is wide and short) and a little in, so
 * they overlap at a corner. */
type Side = "top" | "bottom" | "left" | "right";

const blobs = ([["top", "left"], ["bottom", "right"]] as const).flatMap(([y, x], i) => {
  const formatA = Math.floor(rng() * 3);
  const formatB = (formatA + 1 + Math.floor(rng() * 2)) % 3;
  const first = i === 0 ? 0 : 1;
  const a = sized(formatA);
  const b = sized(formatB);
  const edge = between(-24, -12);
  const step = between(12, 24);
  return [
    { ...a, color: colors[first], float: i * 2, pos: { [y]: edge, [x]: edge } },
    {
      ...b,
      color: colors[1 - first],
      float: i * 2 + 1,
      pos: { [y]: edge + a.w / a.ratio / 2, [x]: edge + step },
    },
  ] as { w: number; ratio: number; color: string; float: number; pos: Partial<Record<Side, number>> }[];
});

const style = (blob: (typeof blobs)[number]) =>
  [
    ...Object.entries(blob.pos).map(([side, px]) => `${side}:${Math.round(px)}px`),
    `width:${Math.round(blob.w)}px`,
    `aspect-ratio:${blob.ratio}`,
    `background:${blob.color}`,
  ].join(";");
---

<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
  {blobs.map((blob) => <div class:list={["banner-blob", `float-${blob.float}`]} style={style(blob)} />)}
</div>

<style>
  .banner-blob {
    position: absolute;
    border-radius: 0.5rem;
    filter: blur(14px);
    animation: banner-float 4s ease-in-out infinite;
  }
  .float-1 {
    animation-duration: 3s;
    animation-delay: -1.5s;
  }
  .float-2 {
    animation-duration: 3.5s;
    animation-delay: -1s;
  }
  .float-3 {
    animation-duration: 4.5s;
    animation-delay: -2s;
  }

  @keyframes banner-float {
    50% {
      transform: translate(6px, -10px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .banner-blob {
      animation: none;
    }
  }
</style>
