---
import AsciiArtGlow from '../AsciiArtGlow.svelte';
---


<section class="w-full">
  <div class="max-w-7xl mx-auto relative py-16">
    <!-- Frosted backdrop so the topo background doesn't blend into the lettering -->
    <div aria-hidden="true" class="hero-backdrop absolute inset-0 z-0 pointer-events-none"></div>

    <!-- Hero Text -->
    <div class="absolute inset-0 flex flex-col items-center justify-center px-4 sm:px-6 md:px-8">
      <h1 class="text-6xl sm:text-7xl md:text-9xl font-bold text-center z-20">
        Jarno Fret
      </h1>
      <h4 class="pb-8 text-md sm:text-2xl font-bold text-zinc-500 text-shadow-lg text-shadow-black text-center z-20">
        Creative, Software Engineer, Content Creator<span class="term-caret" aria-hidden="true"></span>
      </h4>
    </div>

    <!-- ASCII Art -->
    <AsciiArtGlow client:load />
