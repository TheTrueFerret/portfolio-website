*/}
  </div>
</section>

<style>
  .hero-backdrop {
    background: rgb(9 9 11 / 0.6); /* zinc-950 */
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    /* Fade the edges out so there's no visible box */
    mask-image: radial-gradient(
      ellipse 50% 50% at 50% 50%,
      rgb(0 0 0 / 1) 55%,
      rgb(0 0 0 / 0) 100%
    );
  }
</style>
