---
import { Icon } from "astro-icon/components";
---

<section class="w-full py-12">
  <div class="max-w-5xl mx-auto sm:px-4">
    <div
      class="flex flex-col items-center gap-8 text-center text-white font-medium
             sm:text-xl p-6 sm:p-10"
    >
      <h2 class="text-2xl sm:text-4xl md:text-5xl font-bold">
        DM Me on Instagram or LinkedIn
      </h2>

      <p class="max-w-2xl text-zinc-400">
        Prefer a quick message? I'm available on both platforms — drop a DM and
        I'll get back to you.
      </p>

      <div
        class="w-full grid grid-cols-2 gap-6 sm:gap-8 justify-items-center
               items-start md:max-w-3xl"
      >
        <a
          href="https://instagram.com/trueferret"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open my Instagram in a new tab"
          title="Instagram — opens in a new tab"
          class="group focus:outline-none focus-visible:ring-3 focus-visible:ring-offset-2 
                p-4 w-44 h-44 flex flex-col items-center justify-center"
        >
          <div
            class="text-zinc-500 group-hover:text-zinc-100 **:-mt-1"
            aria-hidden="true"
          >
            <Icon name="line-md:instagram" size={160} />
          </div>
          <span class="mt-3 text-sm text-zinc-300 font-semibold">Instagram</span>
        </a>

        <a
          href="https://linkedin.com/in/jarno-fret"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Open my LinkedIn in a new tab"
          title="LinkedIn — opens in a new tab"
          class="group focus:outline-none focus-visible:ring-3 focus-visible:ring-offset-2
                 p-4 w-44 h-44 flex flex-col items-center justify-center"
        >
          <div
            class="text-zinc-500 hover:text-zinc-100 -mt-1"
            aria-hidden="true"
          >
            <Icon name="line-md:linkedin" size={160} />
          </div>
          <span class="mt-3 text-sm text-zinc-300">LinkedIn</span>
        </a>
      </div>
    </div>
  </div>
</section>
